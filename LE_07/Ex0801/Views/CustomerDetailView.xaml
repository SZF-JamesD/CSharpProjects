<Window x:Class="Ex0801.Views.CustomerDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ex0801.Views"
      mc:Ignorable="d" 
      Title="CustomerDetailView" Height="350" Width="400">

    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Customer Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="ID:"/>
            <TextBlock Text="{Binding Customer.CustId}"/>

            <TextBlock Text="Name:" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Customer.FirstName}"/>
            <TextBlock Text="{Binding Customer.LastName}"/>

            <TextBlock Text="Address:" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Customer.Street}"/>
            <TextBlock Text="{Binding Customer.HouseNo}"/>
            <TextBlock Text="{Binding Customer.PostCode}"/>
            <TextBlock Text="{Binding Customer.City}"/>

            <TextBlock Text="Email:" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Customer.Email}"/>

            <TextBlock Text="Created By;" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Customer.CreatedBy}"/>
        </StackPanel>
        
    </Grid>
</Window>
