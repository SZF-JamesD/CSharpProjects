<Window x:Class="Ex0801.Views.AddUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ex0801.Views"
             xmlns:helpers="clr-namespace:Ex0801.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="750">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Label Content="User Management" Grid.Row="0" Grid.ColumnSpan="3" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Content="Enter Username (max 50 chars):" Grid.Row="1" Grid.Column="0" FontSize="16" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0 ,15,0"/>
        <TextBox Name="UsernameTextBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" helpers:WatermarkService.Watermark="Eg. User123" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,49,125,79" Grid.RowSpan="2"/>
        <Label Content="Enter Password (max 50 chars):" Grid.Row="2" Grid.Column="0" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0"/>
        <TextBox Name="PasswordTextBox" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" helpers:WatermarkService.Watermark="Eg. Password123" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,10,125,38"/>
        <Button Content="Add new User" Command="{Binding AddUserCommand}" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="1" VerticalAlignment="Top" Width="240" Padding="1,1,1,1" Margin="5,10,5,5"/>

    </Grid>
</Window>
