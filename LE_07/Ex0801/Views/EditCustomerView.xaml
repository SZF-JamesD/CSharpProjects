<Window x:Class="Ex0801.Views.EditCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ex0801.Views"
             xmlns:helpers="clr-namespace:Ex0801.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Edit Cusomter" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0"/>
        <TextBox Name="FirstNameTextBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="1" Margin="5"/>
        <TextBox Name="LastNameTextBox" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="2" Margin="5"/>
        <TextBox Name="StreetTextBox" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="3" Margin="5"/>
        <TextBox Name="HousenoTextBox" Text="{Binding HouseNo, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Margin="5"/>
        <TextBox Name="PostCodeTextBox" Text="{Binding PostCodeText, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="5" Margin="5"/>
        <TextBox Name="CityTextBox" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Margin="5"/>
        <TextBox Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="7" Margin="5"/>

        <Button Content="Confirm Changes" Command="{Binding SaveChangesCommand}" HorizontalAlignment="Center" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Width="120" Padding="1,1,1,1" Margin="5,5,5,5"/>

    </Grid>
</Window>
