<Window x:Class="Ex0602.UI.NoteDetailWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="NoteDetailWindow" Height="350" Width="400">

    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Title:" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="{Binding Title}" Margin="0,0,0,10" FontSize="14"/>
            <TextBlock Text="Content: " FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
